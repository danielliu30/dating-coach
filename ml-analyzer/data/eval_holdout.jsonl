{"conversation_id": "holdout-001", "user_id": "holdout-user-001", "platform": "hinge", "consented": true, "messages": [{"position": 0, "sender": "self", "body": "your profile says you bake - what was the last thing you made?"}, {"position": 1, "sender": "match", "body": "sourdough, badly. it came out like a frisbee"}, {"position": 2, "sender": "self", "body": "a frisbee loaf is still a loaf. was it the starter or the oven?"}, {"position": 3, "sender": "match", "body": "honestly the starter, I named it and then neglected it lol"}, {"position": 4, "sender": "self", "body": "what did you name it?"}, {"position": 5, "sender": "match", "body": "Doughlores. she deserved better"}, {"position": 6, "sender": "self", "body": "ha, that's a great name. are you giving her another chance this weekend?"}, {"position": 7, "sender": "match", "body": "maybe! if she survives I'll report back"}], "segments": [{"start_position": 0, "end_position": 3, "engagement_score": 0.85}, {"start_position": 4, "end_position": 7, "engagement_score": 0.82}]}
