{"conversation_id": "holdout-006", "user_id": "holdout-user-006", "platform": "hinge", "consented": true, "messages": [{"position": 0, "sender": "self", "body": "ok I need to know the story behind the goat photo"}, {"position": 1, "sender": "match", "body": "LOL it's my cousin's farm, the goat is named Kevin and he hates me"}, {"position": 2, "sender": "self", "body": "what did you do to Kevin??"}, {"position": 3, "sender": "match", "body": "nothing! I just exist. he headbutted me in front of everyone"}, {"position": 4, "sender": "self", "body": "so you're saying Kevin has opinions. respect"}, {"position": 5, "sender": "match", "body": "he has a LOT of opinions. what about you, any animal enemies?"}, {"position": 6, "sender": "self", "body": "a seagull stole my sandwich in Brighton once and I've never recovered"}, {"position": 7, "sender": "match", "body": "the seagulls there are criminals honestly"}], "segments": [{"start_position": 0, "end_position": 3, "engagement_score": 0.92}, {"start_position": 4, "end_position": 7, "engagement_score": 0.88}]}
