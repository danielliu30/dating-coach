{"conversation_id": "holdout-010", "user_id": "holdout-user-010", "platform": "bumble", "consented": true, "messages": [{"position": 0, "sender": "match", "body": "hey! fellow dog person I see"}, {"position": 1, "sender": "self", "body": "yes! that's Biscuit, he's a menace. what's your dog like?"}, {"position": 2, "sender": "match", "body": "a very lazy greyhound, sleeps 20 hours a day"}, {"position": 3, "sender": "self", "body": "greyhounds are the best couch potatoes. does he do the zoomies at all?"}, {"position": 4, "sender": "match", "body": "once a day for exactly 30 seconds then back to bed"}, {"position": 5, "sender": "self", "body": "that's an efficient schedule honestly"}], "segments": [{"start_position": 0, "end_position": 3, "engagement_score": 0.8}, {"start_position": 4, "end_position": 5, "engagement_score": 0.62}]}
