# Copy to .env and adjust. Compose reads this file for every service.

# ---------- shared infrastructure ----------
POSTGRES_USER=datingcoach
POSTGRES_PASSWORD=datingcoach
POSTGRES_DB=datingcoach

# ---------- Go backend (api + worker) ----------
APP_ENV=development
HTTP_ADDR=:8080
# Host-side value; inside compose the services override the host to `postgres`.
DATABASE_URL=postgres://datingcoach:datingcoach@localhost:5432/datingcoach?sslmode=disable
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=24h
BCRYPT_COST=12
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW=1m
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT=60s
ANALYSIS_QUEUE=conversation.analysis
PUBLIC_APP_URL=http://localhost:8081
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Email verification / "analysis ready" mail. Leave SMTP_HOST empty to log
# messages to stdout instead of sending them.
#
# Resend example:
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587
#   SMTP_USERNAME=resend
#   SMTP_PASSWORD=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   MAIL_FROM=onboarding@resend.dev
#
# SendGrid example:
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_USERNAME=apikey
#   SMTP_PASSWORD=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   MAIL_FROM=verify@yourdomain.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-reply@datingcoach.local

# ---------- ML analyzer ----------
# llm (default) | heuristic | trained
ML_BACKEND=llm
# anthropic | openai (any OpenAI-compatible endpoint)
LLM_PROVIDER=anthropic
# Empty key => the analyzer logs a warning and serves the heuristic scorer
# instead (visible as active_backend in GET /healthz and in model_version).
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-5
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=45
ML_SEGMENT_SIZE=6
# Checkpoint directory used when ML_BACKEND=trained
ML_MODEL_DIR=/models/segment-scorer

# ---------- Expo app ----------
# Web/iOS simulator use localhost; an Android emulator needs http://10.0.2.2:8080
EXPO_PUBLIC_API_URL=http://localhost:8080
