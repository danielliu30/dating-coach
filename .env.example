# Copy to .env and adjust. Compose reads this file for every service.

# ---------- shared infrastructure ----------
POSTGRES_USER=datingcoach
POSTGRES_PASSWORD=datingcoach
POSTGRES_DB=datingcoach

# scripts/backup.sh (daily cron on the VM, see README "Backups"). Dumps land in
# BACKUP_DIR (default <repo>/backups, git-ignored), older ones are pruned after
# BACKUP_RETENTION_DAYS. Set BACKUP_S3_URI to also copy each dump off-box with
# `aws s3 cp`; any S3-compatible bucket works via BACKUP_S3_ENDPOINT
# (Backblaze B2: https://s3.<region>.backblazeb2.com, Cloudflare R2:
# https://<account>.r2.cloudflarestorage.com, AWS: leave empty). The key/secret
# are read by the aws CLI from these standard variables.
#BACKUP_DIR=/var/backups/dating-coach
#BACKUP_RETENTION_DAYS=14
#BACKUP_S3_URI=s3://my-bucket/dating-coach
#BACKUP_S3_ENDPOINT=
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_DEFAULT_REGION=us-east-1

# ---------- Go backend (api + worker) ----------
APP_ENV=development
HTTP_ADDR=:8080
# Host-side value; inside compose the services override the host to `postgres`.
DATABASE_URL=postgres://datingcoach:datingcoach@localhost:5432/datingcoach?sslmode=disable
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
JWT_SECRET=change-me-to-a-long-random-string
# Access tokens are deliberately short-lived: nothing revokes them, they are
# renewed through POST /auth/refresh instead.
JWT_TTL=15m
# Lifetime of the verify-scoped token handed out at sign-up.
VERIFY_TOKEN_TTL=30m
# Lifetime of a refresh token; rotation restarts the clock on every exchange.
REFRESH_TOKEN_TTL=720h
BCRYPT_COST=12
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW=1m
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT=60s
ANALYSIS_QUEUE=conversation.analysis
# Deletions are queued here; a failed attempt waits 30s on <name>.retry and
# exhausted deletions land on <name>.dlq.
ACCOUNT_DELETION_QUEUE=account.deletion
# How often the worker logs the dead-letter depth to alert on. Must be positive.
DEAD_LETTER_ALERT_PERIOD=1m
# Origin the browser uses to reach the app. With `docker compose up` that is the
# nginx reverse proxy on :80; verification deep links (/verify?token=...) and
# payment/booking return URLs are built from it. Must include the port when
# NGINX_PORT is not 80 (e.g. http://localhost:8088). Use http://localhost:8081
# when running `expo start --web`.
PUBLIC_APP_URL=http://localhost
# Same-origin through nginx makes CORS moot, but keep every origin listed.
CORS_ORIGINS=http://localhost,http://localhost:8081,http://localhost:19006

# Email verification codes, booking confirmations and "analysis ready" mail.
# Leaving SMTP_HOST empty is the no-provider fallback: the api/worker log each
# message (including the six-digit verification code) to stdout instead of
# sending it. Set a host and the same code is delivered to the user's inbox.
#
# Local inbox without a real provider (`docker compose --profile mail up -d`,
# then open http://localhost:8025):
#   SMTP_HOST=mailpit
#   SMTP_PORT=1025
#   SMTP_USERNAME=
#   SMTP_PASSWORD=
#   MAIL_FROM=no-reply@datingcoach.local
#
# Resend example:
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587
#   SMTP_USERNAME=resend
#   SMTP_PASSWORD=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   MAIL_FROM=onboarding@resend.dev
#
# SendGrid example:
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_USERNAME=apikey
#   SMTP_PASSWORD=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   MAIL_FROM=verify@yourdomain.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Bound on one SMTP delivery (dial through QUIT); a stalled server fails the send.
SMTP_TIMEOUT=30s
# Sender address; a real provider requires a verified domain or address here.
MAIL_FROM=no-reply@datingcoach.local
# Host ports of the optional mailpit inbox (`--profile mail`).
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# "Continue with Google". The OAuth 2.0 *Web application* client ID from
# https://console.cloud.google.com/apis/credentials; the API only accepts ID
# tokens minted for this client. Leave empty to disable POST /auth/google
# (password sign-up with the emailed code keeps working). No client secret is
# needed: ID tokens are verified against Google's public keys. The same ID goes
# to the app as EXPO_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# Paid reservations. Off => booking confirms a session immediately. On =>
# booking holds the slot as pending_payment and sends the client to the
# provider's checkout; STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET are then
# required and the API refuses to start without them.
PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# How long an unpaid booking keeps its slot before it is released.
PAYMENT_HOLD_TTL=15m

# ---------- ML analyzer ----------
# Two tracks share these settings: POST /analyze (the customer's own messages,
# reply-outcome hints, never drafts a reply) and POST /analyze/images (per-photo
# clarity + is-the-customer-the-focal-point). Both are tailored to the user's
# dating_preferences, which the backend attaches to every request.
# llm (default) | heuristic | trained  (trained applies to /analyze only; the
# image track uses the LLM or its heuristic fallback)
ML_BACKEND=llm
# anthropic | openai (any OpenAI-compatible endpoint)
LLM_PROVIDER=anthropic
# Empty key => the analyzer logs a warning and serves the heuristic scorers on
# both tracks (visible as active_backend in GET /healthz and in model_version).
# The heuristic image scorer only reads headers of inline photos; it cannot
# judge who is in frame and says so in its feedback.
LLM_API_KEY=
# Must be vision-capable for the image track (every current default is).
LLM_MODEL=claude-sonnet-4-5
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=45
ML_SEGMENT_SIZE=6
# Checkpoint directory used when ML_BACKEND=trained
ML_MODEL_DIR=/models/segment-scorer

# ---------- Expo app ----------
# Dev server (`expo start`): web/iOS simulator use localhost; an Android
# emulator needs http://10.0.2.2:8080
EXPO_PUBLIC_API_URL=http://localhost:8080
# "Continue with Google" button; same value as GOOGLE_CLIENT_ID above (the
# compose `web` image copies GOOGLE_CLIENT_ID in). Empty hides the button.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
# Docker `web` image (`--profile gateway`): baked in at `expo export` time.
# Empty = same origin as the page, i.e. everything goes through the nginx
# proxy. Set to the public nginx origin (e.g. http://localhost) only if the
# bundle is served elsewhere.
WEB_API_URL=
# Host ports for the gateway profile: nginx entrypoint (keep PUBLIC_APP_URL and
# CORS_ORIGINS in sync with it) and the raw web image (only needed by a
# host-installed nginx; nginx/host-site.conf hardcodes 3000, edit it if changed).
NGINX_PORT=80
WEB_PORT=3000
