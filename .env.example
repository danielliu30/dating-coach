# Copy to .env and adjust. Compose reads this file for every service.

# ---------- shared infrastructure ----------
POSTGRES_USER=datingcoach
POSTGRES_PASSWORD=datingcoach
POSTGRES_DB=datingcoach

# ---------- Go backend (api + worker) ----------
APP_ENV=development
HTTP_ADDR=:8080
# Host-side value; inside compose the services override the host to `postgres`.
DATABASE_URL=postgres://datingcoach:datingcoach@localhost:5432/datingcoach?sslmode=disable
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
JWT_SECRET=change-me-to-a-long-random-string
# Access tokens are deliberately short-lived: nothing revokes them, they are
# renewed through POST /auth/refresh instead.
JWT_TTL=15m
# Lifetime of the verify-scoped token handed out at sign-up.
VERIFY_TOKEN_TTL=30m
# Lifetime of a refresh token; rotation restarts the clock on every exchange.
REFRESH_TOKEN_TTL=720h
BCRYPT_COST=12
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW=1m
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT=60s
ANALYSIS_QUEUE=conversation.analysis
# Deletions are queued here; a failed attempt waits 30s on <name>.retry and
# exhausted deletions land on <name>.dlq.
ACCOUNT_DELETION_QUEUE=account.deletion
# How often the worker logs the dead-letter depth to alert on. Must be positive.
DEAD_LETTER_ALERT_PERIOD=1m
PUBLIC_APP_URL=http://localhost:8081
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Email verification / "analysis ready" mail. Leave SMTP_HOST empty to log
# messages to stdout instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Bound on one SMTP delivery (dial through QUIT); a stalled server fails the send.
SMTP_TIMEOUT=30s
MAIL_FROM=no-reply@datingcoach.local

# Paid reservations. Off => booking confirms a session immediately. On =>
# booking holds the slot as pending_payment and sends the client to the
# provider's checkout; STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET are then
# required and the API refuses to start without them.
PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# How long an unpaid booking keeps its slot before it is released.
PAYMENT_HOLD_TTL=15m

# ---------- ML analyzer ----------
# llm (default) | heuristic | trained
ML_BACKEND=llm
# anthropic | openai (any OpenAI-compatible endpoint)
LLM_PROVIDER=anthropic
# Empty key => the analyzer logs a warning and serves the heuristic scorer
# instead (visible as active_backend in GET /healthz and in model_version).
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-5
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=45
ML_SEGMENT_SIZE=6
# Checkpoint directory used when ML_BACKEND=trained
ML_MODEL_DIR=/models/segment-scorer

# ---------- Expo app ----------
# Web/iOS simulator use localhost; an Android emulator needs http://10.0.2.2:8080
EXPO_PUBLIC_API_URL=http://localhost:8080
