# Compose env for the loadtest stack. Derived from e2e/.env; every value is a
# non-secret test fixture and the stack runs fully offline.
#
#   docker compose --env-file loadtest/.env -f docker-compose.yml \
#     -f loadtest/docker-compose.override.yml --profile gateway up -d --build

POSTGRES_USER=datingcoach
POSTGRES_PASSWORD=datingcoach
POSTGRES_DB=datingcoach
# A local Postgres already owns 5432 on the dev box; publish on 15432.
POSTGRES_PORT=127.0.0.1:15432

APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://datingcoach:datingcoach@localhost:5432/datingcoach?sslmode=disable
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
JWT_SECRET=loadtest-only-not-a-secret-0123456789ab
JWT_TTL=15m
VERIFY_TOKEN_TTL=30m
VERIFY_RESEND_COOLDOWN=1s
REFRESH_TOKEN_TTL=720h
# Cheap hashing: components sign up/sign in hundreds of accounts.
BCRYPT_COST=4
# The whole run comes from one IP; the default of 20/min would throttle it.
# lt-auth's dedicated limiter probe exercises the real defaults separately.
AUTH_RATE_LIMIT=100000
AUTH_RATE_WINDOW=1m
LOGIN_FAILURE_LIMIT=1000
LOGIN_FAILURE_WINDOW=15m
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT=60s
ANALYSIS_QUEUE=conversation.analysis
ACCOUNT_DELETION_QUEUE=account.deletion
DEAD_LETTER_ALERT_PERIOD=1m
PUBLIC_APP_URL=http://localhost
CORS_ORIGINS=http://localhost,http://localhost:8081,http://localhost:19006

# No SMTP: verification codes are logged by the api container and scraped by
# harness.VerificationCode.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT=30s
MAIL_FROM=no-reply@datingcoach.local

# lt-payments flips this to true when the Stripe provider lands; the fake
# Stripe serves STRIPE_BASE_URL via host.docker.internal.
PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=sk_test_lt
STRIPE_WEBHOOK_SECRET=whsec_lt
STRIPE_BASE_URL=http://host.docker.internal:12111
PAYMENT_HOLD_TTL=15m

# Heuristic scorer only; no LLM is configured and none is called.
ML_BACKEND=heuristic
ML_PROFILE_EVIDENCE_ENABLED=true
PROFILE_SCORE_ENABLED=true
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-5
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=45
ML_SEGMENT_SIZE=6
ML_MODEL_DIR=/models/segment-scorer

EXPO_PUBLIC_API_URL=http://localhost:8080
WEB_API_URL=
NGINX_PORT=80
WEB_PORT=127.0.0.1:3000
