{
  "name": "dating-coach-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-driven end-to-end suite against the real docker compose stack.",
  "scripts": {
    "stack:up": "docker compose --env-file e2e/.env --profile gateway up -d --build",
    "stack:down": "docker compose --env-file e2e/.env --profile gateway down -v",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^20.19.0",
    "typescript": "~5.9.2"
  }
}
