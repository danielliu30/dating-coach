# Compose env for the end-to-end suite. Derived from ../.env.example; every
# value is a non-secret test fixture and the stack runs fully offline.
#
#   docker compose --env-file e2e/.env --profile gateway up -d --build

POSTGRES_USER=datingcoach
POSTGRES_PASSWORD=datingcoach
POSTGRES_DB=datingcoach

APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://datingcoach:datingcoach@localhost:5432/datingcoach?sslmode=disable
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
JWT_SECRET=e2e-only-not-a-secret-0123456789abcdef
JWT_TTL=15m
VERIFY_TOKEN_TTL=30m
REFRESH_TOKEN_TTL=720h
# Cheap hashing: the suite signs up dozens of accounts.
BCRYPT_COST=4
# The whole suite comes from one IP; the default of 20/min would throttle it.
AUTH_RATE_LIMIT=1000
AUTH_RATE_WINDOW=1m
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT=60s
ANALYSIS_QUEUE=conversation.analysis
ACCOUNT_DELETION_QUEUE=account.deletion
DEAD_LETTER_ALERT_PERIOD=1m
PUBLIC_APP_URL=http://localhost
CORS_ORIGINS=http://localhost,http://localhost:8081,http://localhost:19006

# No SMTP: verification codes are logged by the api container and scraped by
# helpers/verificationCode.ts.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT=30s
MAIL_FROM=no-reply@datingcoach.local

PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_HOLD_TTL=15m

# Heuristic scorer only; no LLM is configured and none is called.
ML_BACKEND=heuristic
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-5
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=45
ML_SEGMENT_SIZE=6
ML_MODEL_DIR=/models/segment-scorer

EXPO_PUBLIC_API_URL=http://localhost:8080
WEB_API_URL=
NGINX_PORT=80
WEB_PORT=3000
